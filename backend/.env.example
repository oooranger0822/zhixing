DEEPSEEK_API_KEY=replace_with_your_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Exact frontend origins, comma-separated; no wildcard and no trailing path.
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# Vercel requires team authentication AND shared quotas. See VERCEL.md.
# Use three distinct random URL-safe tokens, each at least 32 characters.
AI_ACCESS_TOKENS=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
